# .env.example · Le stesse righe di .env, senza segreti: il modello.
# Questo sì, su GitHub.

# Indirizzo del database PostgreSQL (locale o del servizio di hosting)
DATABASE_URL=postgresql+psycopg://utente:password@localhost:5432/dejabug

# Chiave per firmare i token JWT: una stringa lunga e casuale, diversa per ogni ambiente
# (si genera con: python -c "import secrets; print(secrets.token_hex(32))")
CHIAVE_SEGRETA_JWT=cambiami

# Dopo quanti minuti scade il token del login (240 = 4 ore)
JWT_SCADENZA_MINUTI=240
